    "test:matrix": "node scripts/test-matrix.js",
    "lint": "prettier --check ."
  },
  "keywords": [
    "node",
    "nodejs",
    "boilerplate",
    "template",
    "starter",
    "express",
    "fastify",
    "nestjs",
    "hono",
    "prisma",
    "drizzle",
    "mongoose",
    "typescript",
    "cli",
    "create"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "ejs": "^7.0.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.10.1"
  }
}
