import { describe, expect, it } from 'vitest';
import { request } from './helpers/request.js';
<% if (has.auth) { -%>

async function registerAndLogin(email = 'ada@example.com') {
  const res = await request('POST', '/api/auth/register', {
    body: { email, name: 'Ada Lovelace', password: 'correct-horse-battery' },
  });
  return res.body as { user: { id: string }; accessToken: string };
}

describe('Users API', () => {
  it('rejects requests without a token', async () => {
    const res = await request('GET', '/api/users');
    expect(res.status).toBe(401);
  });

  it('lists users for an authenticated user', async () => {
    const { accessToken } = await registerAndLogin();
    const res = await request('GET', '/api/users', { token: accessToken });
    expect(res.status).toBe(200);
    expect(res.body.total).toBe(1);
    expect(res.body.items[0]).not.toHaveProperty('passwordHash');
  });

  it('returns 404 for an unknown user', async () => {
    const { accessToken } = await registerAndLogin();
    const res = await request('GET', '/api/users/unknown-id', { token: accessToken });
    expect(res.status).toBe(404);
  });

  it('only lets users delete themselves', async () => {
    const ada = await registerAndLogin('ada@example.com');
    const bob = await registerAndLogin('bob@example.com');

    const forbidden = await request('DELETE', `/api/users/${ada.user.id}`, { token: bob.accessToken });
    expect(forbidden.status).toBe(403);

    const ok = await request('DELETE', `/api/users/${ada.user.id}`, { token: ada.accessToken });
    expect(ok.status).toBe(204);
  });
});
<% } else { -%>

describe('Users API', () => {
  it('creates, reads, lists and deletes a user', async () => {
    const created = await request('POST', '/api/users', {
      body: { email: 'ada@example.com', name: 'Ada Lovelace' },
    });
    expect(created.status).toBe(201);
    const id = created.body.id;

    const one = await request('GET', `/api/users/${id}`);
    expect(one.status).toBe(200);
    expect(one.body).toMatchObject({ email: 'ada@example.com', name: 'Ada Lovelace' });

    const list = await request('GET', '/api/users?limit=10');
    expect(list.body).toMatchObject({ total: 1, limit: 10, offset: 0 });

    const removed = await request('DELETE', `/api/users/${id}`);
    expect(removed.status).toBe(204);

    const gone = await request('GET', `/api/users/${id}`);
    expect(gone.status).toBe(404);
  });

  it('validates the request body', async () => {
    const res = await request('POST', '/api/users', { body: { email: 'not-an-email' } });
    expect(res.status).toBe(400);
    expect(res.body.error.code).toBe('BAD_REQUEST');
    expect(res.body.error.details).toEqual(
      expect.arrayContaining([expect.objectContaining({ path: 'email' })]),
    );
  });

  it('rejects duplicate emails', async () => {
    const body = { email: 'ada@example.com', name: 'Ada' };
    await request('POST', '/api/users', { body });
    const res = await request('POST', '/api/users', { body });
    expect(res.status).toBe(409);
  });
});
<% } -%>
