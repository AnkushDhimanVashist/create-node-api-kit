import Fastify from 'fastify';
import cors from '@fastify/cors';
import helmet from '@fastify/helmet';
import { corsOrigin } from './config/env.js';
import { notFound, toErrorResponse } from './common/errors.js';
import fastifyRateLimit from '@fastify/rate-limit';
import { rateLimitOptions } from './common/rate-limit.js';
import { logger } from './lib/logger.js';
import { healthRoutes } from './modules/health/health.routes.js';
import { userRoutes } from './modules/users/user.routes.js';
<% if (has.auth) { -%>
import { authRoutes } from './modules/auth/auth.routes.js';
<% } -%>
<% if (has.swagger) { -%>
import { docsPlugin } from './docs/docs.plugin.js';
<% } -%>

/**
 * Builds the Fastify app without starting it, so tests can use it directly.
 */
export async function buildApp() {
  const app = Fastify({
    loggerInstance: logger,
    bodyLimit: 1024 * 1024,
    disableRequestLogging: (req) => req.url.startsWith('/health'),
  });

  // Security
<% if (has.swagger) { -%>
  // CSP is relaxed so Swagger UI can load its inline assets. Tighten it if you drop /docs.
  await app.register(helmet, { contentSecurityPolicy: false });
<% } else { -%>
  await app.register(helmet);
<% } -%>
  await app.register(cors, { origin: corsOrigin });
<% if (has.auth) { -%>
  app.decorateRequest('user', null);
<% } -%>

  // Every error ends up here and leaves as the same JSON shape.
  app.setErrorHandler((err, request, reply) => {
    const { statusCode, body } = toErrorResponse(err);
    if (statusCode >= 500) request.log.error({ err }, 'Unhandled error');
    return reply.status(statusCode).send(body);
  });
  app.setNotFoundHandler((request, reply) => {
    const { statusCode, body } = toErrorResponse(notFound(`Route ${request.method} ${request.url} not found`));
    return reply.status(statusCode).send(body);
  });

  // Routes
  await app.register(healthRoutes, { prefix: '/health' });
<% if (has.swagger) { -%>
  await app.register(docsPlugin);
<% } -%>
  await app.register(
    async (api) => {
      // Registered inside the /api scope so it only applies to API routes.
      await api.register(fastifyRateLimit, rateLimitOptions);
<% if (has.auth) { -%>
      await api.register(authRoutes, { prefix: '/auth' });
<% } -%>
      await api.register(userRoutes, { prefix: '/users' });
    },
    { prefix: '/api' },
  );

  return app;
}
