import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import { pinoHttp } from 'pino-http';
import { corsOrigin } from './config/env.js';
import { logger } from './lib/logger.js';
import { errorHandler, notFoundHandler } from './common/middleware/error-handler.js';
import { rateLimiter } from './common/middleware/rate-limit.js';
import { healthRouter } from './modules/health/health.routes.js';
import { userRouter } from './modules/users/user.routes.js';
<% if (has.auth) { -%>
import { authRouter } from './modules/auth/auth.routes.js';
<% } -%>
<% if (has.swagger) { -%>
import { docsRouter } from './docs/docs.routes.js';
<% } -%>

/**
 * Builds the Express app without starting it, so tests can use it directly.
 */
export function buildApp() {
  const app = express();

  // Security + parsing
  app.disable('x-powered-by');
  app.use(helmet());
  app.use(cors({ origin: corsOrigin }));
  app.use(express.json({ limit: '1mb' }));

  // One log line per request (health checks are skipped to keep logs quiet)
  app.use(pinoHttp({ logger, autoLogging: { ignore: (req) => req.url?.startsWith('/health') ?? false } }));

  // Routes
  app.use('/health', healthRouter);
<% if (has.swagger) { -%>
  app.use('/docs', docsRouter);
<% } -%>
  app.use('/api', rateLimiter);
<% if (has.auth) { -%>
  app.use('/api/auth', authRouter);
<% } -%>
  app.use('/api/users', userRouter);

  // Must be last
  app.use(notFoundHandler);
  app.use(errorHandler);

  return app;
}
